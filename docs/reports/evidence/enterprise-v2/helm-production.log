# Source: kubecost-auto-hpa/templates/dashboard.yaml
apiVersion: v1
kind: ConfigMap
metadata:
  name: verification-kubecost-auto-hpa-dashboard
  labels:
    app.kubernetes.io/name: kubecost-auto-hpa
    app.kubernetes.io/instance: verification
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: kubecost-auto-hpa-0.1.0
    grafana_dashboard: "1"
  annotations:
    grafana_folder: Nexus FinOps & Kubernetes Economics
data:
  kubecost-autoscaler.json: |-
    {
      "title": "KubeCost Autoscaler",
      "uid": "kubecost-autoscaler",
      "schemaVersion": 39,
      "version": 1,
      "editable": true,
      "tags": [
        "kubecost",
        "autoscaling"
      ],
      "time": {
        "from": "now-6h",
        "to": "now"
      },
      "refresh": "1m",
      "panels": [
        {
          "id": 1,
          "title": "Replicas: current vs desired",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "kubecost_autoscaler_current_replicas{namespace=~\"$namespace\",name=~\"$name\"}",
              "legendFormat": "current {{namespace}}/{{name}}"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "kubecost_autoscaler_desired_replicas{namespace=~\"$namespace\",name=~\"$name\"}",
              "legendFormat": "desired {{namespace}}/{{name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {},
          "description": "Desired is what the last decision proposed; it differs from current while a stabilization window, cooldown or dry-run holds the change back."
        },
        {
          "id": 2,
          "title": "Hourly cost vs budget",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 0,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "kubecost_autoscaler_hourly_cost_usd{namespace=~\"$namespace\",name=~\"$name\"}",
              "legendFormat": "cost {{namespace}}/{{name}}"
            },
            {
              "refId": "B",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "kubecost_autoscaler_budget_usd{namespace=~\"$namespace\",name=~\"$name\"}",
              "legendFormat": "budget {{namespace}}/{{name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "currencyUSD"
            },
            "overrides": []
          },
          "options": {},
          "description": "Allocated hourly run-rate from the last valid KubeCost sample, against spec.costPolicy.maxHourlyCostUSD."
        },
        {
          "id": 3,
          "title": "KubeCost sample age",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 8,
            "w": 8,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "kubecost_autoscaler_metric_age_seconds{namespace=~\"$namespace\",name=~\"$name\"}",
              "legendFormat": "{{namespace}}/{{name}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "unit": "s"
            },
            "overrides": []
          },
          "options": {},
          "description": "Age of the last KubeCost sample; compare with spec.failurePolicy.maxMetricAge."
        },
        {
          "id": 4,
          "title": "Native HPA fallback active",
          "type": "stat",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 8,
            "y": 8,
            "w": 4,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "max(kubecost_autoscaler_fallback_active{namespace=~\"$namespace\",name=~\"$name\"})",
              "legendFormat": "fallback"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "mappings": [
                {
                  "type": "value",
                  "options": {
                    "0": {
                      "text": "off"
                    },
                    "1": {
                      "text": "ACTIVE"
                    }
                  }
                }
              ],
              "thresholds": {
                "mode": "absolute",
                "steps": [
                  {
                    "color": "green",
                    "value": null
                  },
                  {
                    "color": "red",
                    "value": 1
                  }
                ]
              }
            },
            "overrides": []
          },
          "options": {
            "colorMode": "background",
            "reduceOptions": {
              "calcs": [
                "lastNotNull"
              ]
            }
          },
          "description": "1 while the operator-owned native HPA holds the replicas because KubeCost is unavailable."
        },
        {
          "id": 5,
          "title": "KubeCost API errors by class",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 8,
            "w": 12,
            "h": 7
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (class) (increase(kubecost_autoscaler_kubecost_api_errors_total[$__rate_interval]))",
              "legendFormat": "{{class}}"
            }
          ],
          "fieldConfig": {
            "defaults": {},
            "overrides": []
          },
          "options": {},
          "description": "transient, auth, client, malformed, no_data, ambiguous, stale."
        },
        {
          "id": 6,
          "title": "Scaling decisions by type",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 15,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (type) (increase(kubecost_autoscaler_scaling_decisions_total{namespace=~\"$namespace\",name=~\"$name\"}[$__rate_interval]))",
              "legendFormat": "{{type}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "stacking": {
                  "mode": "normal"
                },
                "fillOpacity": 40
              }
            },
            "overrides": []
          },
          "options": {}
        },
        {
          "id": 7,
          "title": "Replica writes by direction and result",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 12,
            "y": 15,
            "w": 12,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (direction, result) (increase(kubecost_autoscaler_scaling_action_total{namespace=~\"$namespace\",name=~\"$name\"}[$__rate_interval]))",
              "legendFormat": "{{direction}} / {{result}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "stacking": {
                  "mode": "normal"
                },
                "fillOpacity": 40
              }
            },
            "overrides": []
          },
          "options": {}
        },
        {
          "id": 8,
          "title": "Pods per capacity class",
          "type": "timeseries",
          "datasource": {
            "type": "prometheus",
            "uid": "${datasource}"
          },
          "gridPos": {
            "x": 0,
            "y": 23,
            "w": 24,
            "h": 8
          },
          "targets": [
            {
              "refId": "A",
              "datasource": {
                "type": "prometheus",
                "uid": "${datasource}"
              },
              "expr": "sum by (class) (kubecost_autoscaler_node_classification{namespace=~\"$namespace\",name=~\"$name\"})",
              "legendFormat": "{{class}}"
            }
          ],
          "fieldConfig": {
            "defaults": {
              "custom": {
                "stacking": {
                  "mode": "normal"
                },
                "fillOpacity": 40
              }
            },
            "overrides": []
          },
          "options": {},
          "description": "spot, ondemand, unknown and pending pods of the target. Price weights are relative, never capacity guarantees."
        }
      ],
      "templating": {
        "list": [
          {
            "name": "datasource",
            "label": "Data source",
            "type": "datasource",
            "query": "prometheus",
            "current": {}
          },
          {
            "name": "namespace",
            "label": "Namespace",
            "type": "query",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "query": {
              "query": "label_values(kubecost_autoscaler_current_replicas, namespace)",
              "refId": "v"
            },
            "refresh": 2,
            "includeAll": true,
            "multi": true,
            "allValue": ".*",
            "current": {
              "text": "All",
              "value": "$__all"
            },
            "sort": 1
          },
          {
            "name": "name",
            "label": "Autoscaler",
            "type": "query",
            "datasource": {
              "type": "prometheus",
              "uid": "${datasource}"
            },
            "query": {
              "query": "label_values(kubecost_autoscaler_current_replicas{namespace=~\"$namespace\"}, name)",
              "refId": "v"
            },
            "refresh": 2,
            "includeAll": true,
            "multi": true,
            "allValue": ".*",
            "current": {
              "text": "All",
              "value": "$__all"
            },
            "sort": 1
          }
        ]
      }
    }
    

