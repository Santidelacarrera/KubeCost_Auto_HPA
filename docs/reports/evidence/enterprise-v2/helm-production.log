# Source: kubecost-auto-hpa/templates/engine.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: verification-kubecost-auto-hpa-engine
  labels:
    app.kubernetes.io/name: kubecost-auto-hpa
    app.kubernetes.io/instance: verification
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: kubecost-auto-hpa-0.1.0
spec:
  replicas: 1
  strategy: {type: Recreate}
  selector:
    matchLabels:
      app.kubernetes.io/name: kubecost-auto-hpa
      app.kubernetes.io/instance: verification
      app.kubernetes.io/component: engine
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kubecost-auto-hpa
        app.kubernetes.io/instance: verification
        app.kubernetes.io/component: engine
    spec:
      automountServiceAccountToken: false
      securityContext: {runAsNonRoot: true, runAsUser: 65532, fsGroup: 65532, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: engine
        image: "ghcr.io/santidelacarrera/kubecost-auto-hpa-engine:0.1.0"
        imagePullPolicy: IfNotPresent
        env:
        - {name: ENABLE_AUTOMATED_CONSOLIDATION, value: "false"}
        - {name: SAAS_DB_PATH, value: /data/control-plane.db}
        - {name: STANDALONE_SINGLE_REPLICA, value: "true"}
        - name: ENGINE_TOKEN
          valueFrom: {secretKeyRef: {name: kubecost-engine-auth, key: token}}
        - {name: TLS_CERT, value: /tls/tls.crt}
        - {name: TLS_KEY, value: /tls/tls.key}
        - {name: TLS_CLIENT_CA, value: /tls/ca.crt}   # mTLS: only clients signed by this CA are accepted
        - name: NEXUS_TELEMETRY_ENABLED
          value: "true"
        - name: REDIS_URL
          value: "redis://kubecost-auto-hpa-redis:6379/0"
        - name: NEXUS_TELEMETRY_STREAM
          value: "nexus:telemetry"
        - name: NEXUS_TENANT_ID
          value: "6f1c2a7e-0b3d-4c8e-9a51-2d7f0e4b9c10"
        ports: [{name: http, containerPort: 8000}]
        # kubelet has no client certificate, so under mTLS probe the TCP port only
        livenessProbe: {tcpSocket: {port: http}}
        readinessProbe: {tcpSocket: {port: http}}
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        volumeMounts:
        - {name: tls, mountPath: /tls, readOnly: true}
        - {name: data, mountPath: /data}
      volumes:
      - {name: tls, secret: {secretName: kubecost-engine-server-tls}}
      - name: data
        persistentVolumeClaim: {claimName: verification-kubecost-auto-hpa-engine}

---
# Source: kubecost-auto-hpa/templates/operator.yaml
apiVersion: apps/v1
kind: Deployment
metadata:
  name: verification-kubecost-auto-hpa-operator
  labels:
    app.kubernetes.io/name: kubecost-auto-hpa
    app.kubernetes.io/instance: verification
    app.kubernetes.io/managed-by: Helm
    helm.sh/chart: kubecost-auto-hpa-0.1.0
spec:
  replicas: 2
  selector:
    matchLabels:
      app.kubernetes.io/name: kubecost-auto-hpa
      app.kubernetes.io/instance: verification
      app.kubernetes.io/component: operator
  template:
    metadata:
      labels:
        app.kubernetes.io/name: kubecost-auto-hpa
        app.kubernetes.io/instance: verification
        app.kubernetes.io/component: operator
    spec:
      serviceAccountName: verification-kubecost-auto-hpa
      securityContext: {runAsNonRoot: true, seccompProfile: {type: RuntimeDefault}}
      containers:
      - name: manager
        image: "ghcr.io/santidelacarrera/kubecost-auto-hpa-operator:0.1.0"
        imagePullPolicy: IfNotPresent
        args:
        - --leader-elect
        - --enable-spot-drain=false
        - --enable-cost-autoscaler=true
        - --kubecost-max-attempts=3
        - --drain-timeout=2m
        - --cpu-price-per-core-hour=0.031
        - --mem-price-per-gib-hour=0.004
        - --engine-ca-file=/tls/engine-client/ca.crt
        - --engine-client-cert=/tls/engine-client/tls.crt
        - --engine-client-key=/tls/engine-client/tls.key
        env:
        - {name: PROMETHEUS_URL, value: "http://prometheus-server.monitoring:80"}
        - {name: KUBECOST_URL, value: "http://kubecost-cost-analyzer.kubecost:9090"}
        - {name: ENGINE_URL, value: "https://verification-kubecost-auto-hpa-engine:8000"}
        - {name: REDIS_ADDR, value: "verification-kubecost-auto-hpa-redis:6379"}
        - name: ENGINE_TOKEN
          valueFrom: {secretKeyRef: {name: kubecost-engine-auth, key: token}}
        ports:
        - {name: metrics, containerPort: 8080}
        - {name: probes, containerPort: 8081}
        livenessProbe: {httpGet: {path: /healthz, port: probes}, initialDelaySeconds: 15}
        readinessProbe: {httpGet: {path: /readyz, port: probes}, initialDelaySeconds: 5}
        resources:
          limits:
            memory: 512Mi
          requests:
            cpu: 100m
            memory: 128Mi
        securityContext: {allowPrivilegeEscalation: false, readOnlyRootFilesystem: true, capabilities: {drop: [ALL]}}
        volumeMounts:
        - {name: engine-server-tls, mountPath: /tls/engine-server, readOnly: true}
        - {name: engine-client-tls, mountPath: /tls/engine-client, readOnly: true}
      volumes:
      - {name: engine-server-tls, secret: {secretName: kubecost-engine-server-tls}}
      - {name: engine-client-tls, secret: {secretName: kubecost-operator-client-tls}}

