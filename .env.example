# ==============================================================================
# KubeCost Auto-HPA — Production Environment Configuration Template (.env.example)
# ==============================================================================
# Copy this file to `.env` for local development or inject via Kubernetes Secrets
# in production (`deploy/helm/kubecost-auto-hpa/values-production.yaml`).
# NEVER commit real API keys, tokens, or secrets to Git.

# --- Environment & Strict Security Mode ---
# Set to "production" to enforce mandatory authentication on all /v1/* routes
# and mandatory distributed Redis rate limiting (fail-closed if Redis is down).
KUBECOST_ENV=development
REQUIRE_AUTH=false
STANDALONE_SINGLE_REPLICA=false

# --- Authentication & Multi-Tenant Credentials ---
# Shared M2M bearer token for the Go Kubernetes Operator (generate with: openssl rand -hex 32)
ENGINE_TOKEN=
# Optional: bind ENGINE_TOKEN to a single tenant ID (recommended for single-tenant operator deployments)
ENGINE_TOKEN_TENANT_ID=
# Role for ENGINE_TOKEN: "service" (default, tenant-restricted) or "admin"
ENGINE_TOKEN_ROLE=service
# Optional dedicated global administrative token for cross-tenant provisioning
ENGINE_ADMIN_TOKEN=

# --- Stripe Commercial Billing & Webhook Verification ---
# Mandatory for POST /v1/billing/stripe-webhook (HMAC-SHA256 verification).
# No fallback secret exists in code; if unset, the webhook endpoint fails closed with HTTP 503.
STRIPE_WEBHOOK_SECRET=

# --- Distributed Rate Limiting & Telemetry Bus (Redis) ---
# Required in multi-replica production for atomic rate limiting and `nexus:telemetry` Redis Streams.
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REQUIRE_REDIS=false

# --- Rate Limiting Thresholds & Daily Quotas ---
# POST /v1/auth/keys brute-force protection (requests per minute per IP)
RATE_LIMIT_AUTH_KEYS_PER_MIN=10
# Compute-intensive endpoints (/v1/evaluate, /v1/cluster/binpack, /v1/gpu/optimize, /v1/gameday/simulate)
RATE_LIMIT_COMPUTE_PER_MIN=60
RATE_LIMIT_COMPUTE_IP_PER_MIN=120
# Atomic daily evaluation quota per tenant (UTC day)
RATE_LIMIT_DAILY_EVAL_QUOTA=10000
# General read/API endpoints (/v1/*)
RATE_LIMIT_GENERAL_PER_MIN=120
RATE_LIMIT_GENERAL_IP_PER_MIN=240
# Go Operator telemetry ingestion (/v1/telemetry/ingest, /v1/agents/heartbeat)
RATE_LIMIT_TELEMETRY_PER_MIN=600
RATE_LIMIT_TELEMETRY_IP_PER_MIN=1200
RATE_LIMIT_DAILY_TELEMETRY_QUOTA=250000
# Stripe webhook delivery burst allowance (per minute per IP)
RATE_LIMIT_STRIPE_WEBHOOK_PER_MIN=120

# --- Persistence (SQLite WAL / PostgreSQL + TimescaleDB with RLS) ---
SAAS_DB_PATH=.prod-bootstrap/kubecost_saas.db
POSTGRES_DSN=

# --- Nexus Telemetry Contract (2_Areas/Empresa/_Contrato_Telemetria.md) ---
NEXUS_TELEMETRY_ENABLED=false
NEXUS_TELEMETRY_STREAM=nexus:telemetry
NEXUS_TENANT_ID=6f1c2a7e-0b3d-4c8e-9a51-2d7f0e4b9c10

# --- Network, Proxy & HTTP Framing Hardening ---
PORT=8000
MAX_WORKERS=256
# Comma-separated list of trusted reverse-proxy IPs/CIDRs allowed to set X-Forwarded-For
TRUSTED_PROXIES=
# Optional space-separated origins allowed to embed the console via CSP frame-ancestors (e.g. Nexus Client Portal)
ALLOWED_FRAME_ANCESTORS=

# --- mTLS / TLS Server Configuration ---
TLS_CERT=
TLS_KEY=
TLS_CLIENT_CA=
