{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "kubecost-auto-hpa values",
  "type": "object",
  "properties": {
    "operator": {
      "type": "object",
      "properties": {
        "extraArgs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "extraEnv": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumes": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "extraVolumeMounts": {
          "type": "array",
          "items": {
            "type": "object"
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "leaderElect": {
          "type": "boolean"
        },
        "observeOnly": {
          "type": "boolean"
        },
        "recommendationApplier": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "enforceSeparationOfDuties": {
              "type": "boolean"
            },
            "namespaces": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "maxObserve": {
              "type": "string",
              "pattern": "^[0-9]+(s|m|h)$"
            },
            "auditURL": {
              "type": "string",
              "pattern": "^(https://.+)?$"
            },
            "auditTokenSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "auditCASecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string"
                }
              }
            },
            "policy": {
              "type": "string"
            }
          }
        },
        "enableSpotDrain": {
          "type": "boolean"
        },
        "enableCostAutoscaler": {
          "type": "boolean"
        },
        "kubecostMaxAttempts": {
          "type": "integer",
          "minimum": 1
        },
        "drainTimeout": {
          "type": "string",
          "pattern": "^([0-9]+(\\.[0-9]+)?(ns|us|\u00c2\u00b5s|ms|s|m|h))+$"
        },
        "cpuPricePerCoreHour": {
          "type": [
            "string",
            "number"
          ]
        },
        "memPricePerGiBHour": {
          "type": [
            "string",
            "number"
          ]
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "engine": {
      "type": "object",
      "properties": {
        "http": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxWorkers": {"type": "integer", "minimum": 1, "maximum": 1024},
            "socketTimeoutSeconds": {"type": "number", "minimum": 0.1, "maximum": 300}
          }
        },
        "podDisruptionBudget": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "minAvailable": {
              "type": [
                "integer",
                "string"
              ],
              "minimum": 0
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "object",
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string"
            },
            "pullPolicy": {
              "type": "string",
              "enum": [
                "Always",
                "IfNotPresent",
                "Never"
              ]
            }
          },
          "additionalProperties": false
        },
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "resources": {
          "type": "object",
          "properties": {
            "requests": {
              "type": "object"
            },
            "limits": {
              "type": "object"
            }
          },
          "additionalProperties": false
        },
        "persistence": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "size": {
              "type": "string",
              "minLength": 1
            },
            "storageClass": {
              "type": "string"
            }
          },
          "required": [
            "enabled",
            "size",
            "storageClass"
          ],
          "additionalProperties": false
        },
        "stripeCheckout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["test", "live"]},
            "secretName": {"type": "string"}
          }
        },
        "postgres": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "secretName",
            "key"
          ],
          "additionalProperties": false
        },
        "retention": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "enabled",
            "days",
            "intervalSeconds"
          ],
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "days": {
              "type": "integer",
              "minimum": 1,
              "maximum": 3650
            },
            "intervalSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 86400
            }
          }
        }
      },
      "additionalProperties": false
    },
    "prometheus": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "kubecost": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "redis": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "external": {
          "type": "object",
          "properties": {
            "addr": {
              "type": "string"
            },
            "passwordSecret": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                },
                "key": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "image": {
          "type": "string",
          "minLength": 1
        },
        "maxmemory": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "serviceMonitor": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "auth": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "prometheus": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        },
        "kubecost": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "key": {
              "type": "string",
              "minLength": 1
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "tls": {
      "type": "object",
      "properties": {
        "engine": {
          "type": "object",
          "properties": {
            "secretName": {
              "type": "string"
            },
            "clientSecretName": {
              "type": "string"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "networkPolicy": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "operatorEgress": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object"
              }
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "prometheusRule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "alertNotifications": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {"type": "boolean"},
        "webhookSecretName": {"type": "string"},
        "webhookSecretKey": {"type": "string", "minLength": 1},
        "testAlert": {"type": "boolean"}
      }
    },
    "grafanaDashboard": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "labelValue": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        }
      },
      "additionalProperties": false
    },
    "features": {
      "type": "object",
      "properties": {
        "predictiveScaling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "warmupLeadTimeSeconds": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "oomProtection": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "criticalThresholdPercent": {
              "type": "integer"
            },
            "warningThresholdPercent": {
              "type": "integer"
            },
            "maxLimitMiB": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        },
        "nodeBinPacking": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "consolidationThresholdPercent": {
              "type": "integer"
            }
          },
          "additionalProperties": false
        }
      },
      "additionalProperties": false
    },
    "telemetry": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "redisUrl": {
          "type": "string"
        },
        "stream": {
          "type": "string"
        },
        "tenantId": {
          "type": "string"
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
